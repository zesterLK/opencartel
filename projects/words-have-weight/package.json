{
  "name": "words-have-weight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A tactile typography playground with six word behaviours.",
  "license": "MIT",
  "scripts": {
    "source": "node scripts/source-archive.mjs",
    "predev": "npm run source",
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "prebuild": "npm run source",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5174 --strictPort"
  },
  "dependencies": {
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/opentype.js": "^1.3.8",
    "fflate": "^0.8.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
