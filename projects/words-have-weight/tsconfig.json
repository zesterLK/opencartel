{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable", "ES2022.Intl"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noEmit": true, "allowImportingTsExtensions": true, "esModuleInterop": true,
    "skipLibCheck": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "vite.config.ts"]
}
