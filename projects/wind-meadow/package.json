{
  "name": "wind-meadow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A living field of curved grass, travelling wind and sunlight.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "source": "node scripts/source-archive.mjs",
    "predev": "npm run source",
