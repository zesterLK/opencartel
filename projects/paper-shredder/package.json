{
  "name": "paper-shredder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One last task in a quiet illustrated office: feed a page through a physical paper shredder.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "source": "node scripts/source-archive.mjs",
    "predev": "npm run source",
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "prebuild": "npm run source",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5175 --strictPort"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "0.186.0",
    "fflate": "^0.8.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
